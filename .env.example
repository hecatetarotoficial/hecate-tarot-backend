# ==========================================================
# Copia este archivo como ".env" y rellena tus propias claves
# ==========================================================

# Puerto del servidor
PORT=4000

# --- PAYPAL (pagos reales, la app usa esto) ---
# Sacadas en https://developer.paypal.com/dashboard/applications/live
# (cambia PAYPAL_MODE a "sandbox" solo si quieres probar con pagos falsos)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- STRIPE (pagos reales, no usado por ahora — la app usa PayPal) ---
# Consíguelas en https://dashboard.stripe.com/apikeys
# Empieza SIEMPRE con las claves de TEST (pk_test_/sk_test_) hasta validar el flujo completo,
# y cambia a las de LIVE (pk_live_/sk_live_) solo cuando vayas a cobrar de verdad.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Moneda para los cobros (ISO 4217, minúsculas)
CURRENCY=eur

# Precio (en céntimos) por cada pregunta de tarot respondida por audio
PRICE_PER_QUESTION_CENTS=299

# Precio (en céntimos) de la 2ª tirada instantánea en adelante (la 1ª es siempre gratis)
PRICE_PER_EXTRA_DRAW_CENTS=99

# Precio (en céntimos) del curso de iniciación al tarot (desbloqueo permanente)
PRICE_COURSE_CENTS=999

# Precio (en céntimos) del curso de Feng Shui en el hogar (desbloqueo permanente)
PRICE_FENGSHUI_COURSE_CENTS=1499

# Precio (en céntimos) de la consulta en chat continuo con Hekate (pago único, desbloqueo permanente)
PRICE_CONSULTA_CENTS=299

# La carta astral completa es GRATUITA (no tiene variable de precio; ver astralRoutes.js)

# --- TEXTO A VOZ (TTS) ---
# Proveedor por defecto: "openai" (voz natural, buena calidad con el modelo "hd").
# Para la voz MÁS realista disponible, cambia TTS_PROVIDER a "elevenlabs" y rellena
# las claves de ElevenLabs (creas una voz o eliges una ya hecha en https://elevenlabs.io).
TTS_PROVIDER=openai

# OpenAI TTS
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# ElevenLabs TTS (voz más realista; requiere cuenta en https://elevenlabs.io)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- CORS ---
# En producción, restringe esto al dominio/app real
CORS_ORIGIN=*
